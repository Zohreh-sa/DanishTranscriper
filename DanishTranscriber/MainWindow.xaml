<Window x:Class="DanishTranscriber.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Danish Classroom Transcriber" Height="620" Width="900" WindowStartupLocation="CenterScreen"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Danish Classroom Transcriber" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Ready" Margin="0,6,0,12"/></StackPanel><TextBox x:Name="TranscriptBox" Grid.Row="1" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="StartButton" Content="Start" Width="110" Height="36" Click="Start_Click"/><Button x:Name="StopButton" Content="Stop" Width="110" Height="36" Margin="8,0,0,0" IsEnabled="False" Click="Stop_Click"/><Button Content="Clear" Width="110" Height="36" Margin="8,0,0,0" Click="Clear_Click"/><Button Content="Copy All" Width="110" Height="36" Margin="8,0,0,0" Click="Copy_Click"/></StackPanel></Grid></Window>